CORE_PORT=8000

NODE_ENV=development

CORS_ORIGIN_WHITELIST=http://localhost:3000,http://127.0.0.1:3000
AUTH=false

# Auth cookie attributes. Defaults (lax/false) are correct for same-origin
# setups (e.g. `soul -S`). For a frontend hosted on a different origin
# talking to this API with credentials, set CORS_ORIGIN_WHITELIST to that
# exact origin (never *), COOKIE_SAMESITE=none, and COOKIE_SECURE=true
# (browsers treat localhost as trustworthy even over plain http, so this
# still works for local cross-origin dev).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=10

DB=foobar.db


ACCESS_TOKEN_EXPIRATION_TIME=10H
REFRESH_TOKEN_EXPIRATION_TIME=2D

INITIAL_USER_USERNAME
INITIAL_USER_PASSWORD
TOKEN_SECRET

START_WITH_STUDIO=false
