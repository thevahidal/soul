{
  "name": "soul-cli",
  "version": "0.9.2",
  "description": "A SQLite REST and Realtime server",
  "main": "src/server.js",
  "bin": {
    "soul": "./src/server.js"
  },
  "engines": {
    "node": "22.x || 23.x || 24.x || 25.x || 26.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "npm run swagger-autogen && cross-env NO_CLI=true nodemon src/server.js",
    "cli": "nodemon src/server.js --database foobar.db",
    "swagger-autogen": "cross-env NO_CLI=true node src/swagger/index.js",
    "test": "cross-env CI=true NODE_ENV=test NO_CLI=true DB=test.db CORE_PORT=8001 AUTH=true TOKEN_SECRET=test-only-ci-secret-0123456789 INITIAL_USER_USERNAME=admin INITIAL_USER_PASSWORD=Str0ngTestPw!1 jest --testTimeout=10000 --runInBand --forceExit",
    "test:coverage": "npm test -- --coverage --coverageProvider=v8",
    "prepare": "husky",
    "lint": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevahidal/soul.git"
  },
  "author": "Vahid Al @thevahidal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thevahidal/soul/issues"
  },
  "homepage": "https://github.com/thevahidal/soul#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^1.20.2",
    "check-password-strength": "^2.0.7",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "express-winston": "^4.2.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "soul-studio": "^0.0.1",
    "swagger-ui-express": "^4.6.1",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.3",
    "prettier": "3.1.0",
    "supertest": "^7.1.4",
    "swagger-autogen": "^2.23.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/tests/",
      "/src/cli.js",
      "/src/commands.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 92,
        "branches": 85,
        "functions": 100,
        "lines": 92
      }
    },
    "globalSetup": "./src/tests/globalSetup.js",
    "globalTeardown": "./src/tests/globalTeardown.js"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{js,css,md,html,json}": "prettier --write"
  }
}
